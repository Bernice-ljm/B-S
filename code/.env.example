# Copy to .env for local Compose use. Replace both values before starting.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_DATABASE=enterprise_approval
MYSQL_USER=approval_app
BACKEND_PORT=8080
DB_POOL_MIN_IDLE=2
DB_POOL_MAX_SIZE=10
